   "source": [
    "# Find records where the totals do not match\n",
    "df[\"Total Difference\"] = (\n",
    "    df[\"Total (USD)\"] - df[\"Expected Total (USD)\"]\n",
    ").round(2)\n",
    "\n",
    "print(\"Records with mismatched totals:\")\n",
    "display(df[df[\"Total Difference\"].abs() > 0.01])\n"
   ]
  },
