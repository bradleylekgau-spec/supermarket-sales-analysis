   ],
   "source": [
    "\n",
    "# Key supermarket sales metrics\n",
    "\n",
    "print(\"Total Revenue (USD):\",\n",
    "      round(df_clean[\"Total (USD)\"].sum(), 2))\n",
    "\n",
    "print(\"Total Orders:\",\n",
    "      df_clean[\"Order No\"].nunique())\n",
    "\n",
    "print(\"Total Items Sold:\",\n",
    "      df_clean[\"Order Quantity\"].sum())\n",
    "\n",
    "print(\"Average Order Value (USD):\",\n",
    "      round(df_clean[\"Total (USD)\"].mean(), 2))\n",
    "\n",
    "print(\"Average Order Quantity:\",\n",
    "      round(df_clean[\"Order Quantity\"].mean(), 2))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 67,
   "id": "4cec77c7-7531-4a3e-91cd-237e612d75a8",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Analysis of monthly revenue"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 68,
   "id": "8cbab771-c8ea-4dc0-9671-e03204016950",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Extract the month from the order date\n",
    "df_clean[\"Month\"] = (\n",
    "    df_clean[\"Order Date\"].dt.to_period(\"M\").astype(str)\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 69,
   "id": "cdc8f655-fe22-404a-a3a5-1fbf6b055d1f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Monthly revenue:\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "Month\n",
       "2024-01    9601.372\n",
       "2024-02    1253.780\n",
       "Name: Total (USD), dtype: float64"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Calculate revenue by month\n",
    "monthly_sales = (\n",
    "    df_clean.groupby(\"Month\")[\"Total (USD)\"]\n",
    "    .sum()\n",
    "    .sort_index()\n",
    ")\n",
    "\n",
    "print(\"Monthly revenue:\")\n",
    "display(monthly_sales)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 70,
   "id": "5242df05-301d-4b13-8cd4-abff02ad4f24",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Plot monthly revenue\n",
    "monthly_sales.plot(kind=\"bar\", figsize=(10, 5))\n",
    "\n",
    "plt.title(\"Monthly Supermarket Revenue\")\n",
    "plt.xlabel(\"Month\")\n",
    "plt.ylabel(\"Revenue (USD)\")\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
