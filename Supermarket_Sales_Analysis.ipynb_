   "source": [
    "# Remove temporary validation columns\n",
    "df_clean = df.drop(\n",
    "    columns=[\"Expected Total (USD)\", \"Total Difference\"],\n",
    "    errors=\"ignore\"\n",
    ").copy()"
   ]
  },
