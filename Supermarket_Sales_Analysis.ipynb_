   "outputs": [],
   "source": [
    "# Calculate expected totals\n",
    "df[\"Expected Total (USD)\"] = (\n",
    "    df[\"Retail Price (USD)\"] * df[\"Order Quantity\"]\n",
    "    + df[\"Tax (USD)\"]\n",
    ").round(2)"
   ]
  },
