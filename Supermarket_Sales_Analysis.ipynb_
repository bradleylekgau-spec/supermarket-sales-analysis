   "source": [
    "\n",
    "quantity_analysis = (\n",
    "    df_clean.groupby(\"Order Quantity\")\n",
    "    .agg(\n",
    "        Number_of_Orders=(\"Order No\", \"nunique\"),\n",
    "        Total_Revenue=(\"Total (USD)\", \"sum\"),\n",
    "        Average_Order_Value=(\"Total (USD)\", \"mean\")\n",
    "    )\n",
    "    .round(2)\n",
    ")\n",
    "\n",
    "display(quantity_analysis)\n"
   ]
  },
