   "source": [
    "customer_sales = (\n",
    "    df_clean.groupby(\"Customer Name\")\n",
    "    .agg(\n",
    "        Total_Revenue=(\"Total (USD)\", \"sum\"),\n",
    "        Number_of_Orders=(\"Order No\", \"nunique\")\n",
    "    )\n",
    "    .sort_values(\"Total_Revenue\", ascending=False)\n",
    ")\n",
    "\n",
    "print(\"Top 10 customers by revenue:\")\n",
    "display(customer_sales.head(10))"
   ]
  },
  {
